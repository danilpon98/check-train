# Всё необязательно: Telegram и остальное настраивается в веб-интерфейсе.
# Значения отсюда важнее введённых в интерфейсе.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
# WEB_PORT=8765
# WEB_HOST=127.0.0.1        # 0.0.0.0 — открыть в локальную сеть (тогда задайте WEB_PASSWORD)
# WEB_PASSWORD=
# OPEN_BROWSER=1            # 0 — не открывать браузер при запуске
# DATA_DIR=data
